# ================================================================
# SmartUni.Ai Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ================================================================

# ---- Core ----
ENV=development
# Set to "production" for deployment. Dev-mode is hard-blocked in production.

# ---- Auth ----
AUTH_MODE=dev
# Options: dev | supabase
# "dev" uses local email+password (argon2) + HS256 JWT.
# "supabase" verifies Supabase JWTs and maps sub -> profiles.id.
# Hard-disabled in production — startup will FAIL if AUTH_MODE=dev and ENV=production.

JWT_SECRET=CHANGE_ME_TO_RANDOM_32_BYTES_HEX
# Required in AUTH_MODE=dev. Use: python -c "import secrets; print(secrets.token_hex(32))"

JWT_ALGORITHM=HS256
JWT_TTL_SECONDS=86400

# ---- Database ----
DATABASE_URL=postgresql+psycopg://smartuni:smartuni@localhost:5432/smartuni_dev
# For Supabase transaction pooler, append: ?prepare_threshold=0
# For Supabase session pooler (Alembic migrations), use port 5432 direct.

DIRECT_URL=postgresql+psycopg://smartuni:smartuni@localhost:5432/smartuni_dev
# Used by Alembic for migrations (direct connection, no pooler).

# ---- Supabase (only needed when AUTH_MODE=supabase) ----
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Comma-separated. Wildcard CORS is blocked in production.

# ---- LLM / AI ----
LLM_PROVIDER=gemini
# Options: gemini | mock (returns canned responses, no API key needed)

GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-flash
# Comma-separated fallback chain. First working model is used.

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# ---- Payments ----
PAYMENT_MODE=mock
# Options: mock | razorpay
# "mock" simulates gateway, no real keys needed (safe for demo).

RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# ---- Storage ----
STORAGE_BACKEND=local
# Options: local | supabase
# "local" stores files under backend/data/uploads/

# ---- Certificate Verification ----
PUBLIC_VERIFY_BASE_URL=http://localhost:3000
# The URL used in QR codes. Set to your public deploy URL in production.

# ---- Background Jobs ----
ENABLE_SCHEDULER=false
# Set to "true" to enable APScheduler (SLA escalation, fee reminders, ML re-score, etc.)
# Only run in one process — do NOT set this in a horizontally-scaled deployment.

TRANSPORT_SIMULATOR=false
# Set to "true" to enable the bus position simulator job.

# ---- Biometrics ----
FACE_VERIFIER=simulated
# Options: simulated | embedding
# "simulated" uses a deterministic algorithm (safe for demo/CI).
# "embedding" compares client-supplied cosine embeddings against enrolled embeddings.

# ---- Demo Seeds ----
DEMO_STUDENT_PASSWORD=demo1234
DEMO_FACULTY_PASSWORD=demo1234
DEMO_ADMIN_PASSWORD=demo1234
DEMO_CANTEEN_PASSWORD=demo1234

# ---- Misc ----
PORT=8000
LOG_LEVEL=INFO
